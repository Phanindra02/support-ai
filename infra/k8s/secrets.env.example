# The API's keys, for the support-ai-secrets Secret. Copy this file to infra/k8s/secrets.env,
# which git ignores, put in the values from .env, and then:
#   kubectl create secret generic support-ai-secrets --from-env-file=infra/k8s/secrets.env
#
# Kubernetes keeps a Secret apart from the manifests, and only pods that ask for it by name
# get it (the API, the worker, and the migrations, not the model service). Leave a value
# empty to turn its feature off, as an unset value in .env does.

# Like .env's, but the Mac's Postgres is host.minikube.internal from inside minikube.
DATABASE_URL=postgresql+psycopg://support:PASSWORD@host.minikube.internal:5432/support
# At least 32 characters.
JWT_SECRET_KEY=
TWILIO_AUTH_TOKEN=
N8N_WEBHOOK_SECRET=
LAMBDA_WEBHOOK_SECRET=
OPENAI_API_KEY=
