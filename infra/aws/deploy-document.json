{
  "schemaVersion": "2.2",
  "description": "Deploy one commit of support-ai on the EC2 server: its code and its images",
  "parameters": {
    "commit": {
      "type": "String",
      "description": "The full id of a commit on main",
      "allowedPattern": "^[0-9a-f]{40}$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deploy",
      "inputs": {
        "workingDirectory": "/home/ubuntu/support-ai",
        "timeoutSeconds": "600",
        "runCommand": [
          "set -eu",
          "COMMIT={{ commit }}",
          "SHORT=$(printf %.7s \"$COMMIT\")",
          "as_ubuntu() { sudo -u ubuntu -H \"$@\"; }",
          "as_ubuntu git fetch --quiet origin main",
          "as_ubuntu git merge --quiet --ff-only \"$COMMIT\"",
          "as_ubuntu sed -i -E \"s#^((API|MODEL)_IMAGE=.*):[^:/]*\\$#\\1:sha-$SHORT#\" .env",
          "as_ubuntu docker compose pull --quiet",
          "as_ubuntu docker compose up -d --no-build",
          "as_ubuntu docker compose ps --format '{{.Name}} {{.Image}} {{.Status}}'"
        ]
      }
    }
  ]
}
