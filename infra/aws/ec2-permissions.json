{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SaveUploadedDocs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::support-ai-docs-phanindra02/uploads/*"
    },
    {
      "Sid": "LogInToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullTheApiImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-2:ACCOUNT_ID:repository/support-ai-api"
    },
    {
      "Sid": "LoadTheAppSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": "arn:aws:ssm:us-east-2:ACCOUNT_ID:parameter/support-ai"
    }
  ]
}
