# Copy this file to .env and fill in real values. .env is git-ignored, so secrets stay local.
# A real environment variable with the same name overrides the value here.

# PostgreSQL through the psycopg 3 driver: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# On EC2 it's the RDS URL from Parameter Store (infra/aws/README.md).
DATABASE_URL=postgresql+psycopg://support:change-me@localhost:5432/support

# A separate database for the tests, which empty it. Its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://support:change-me@localhost:5432/support_test

# Redis, for the cache. The number at the end picks one of Redis's numbered databases (0 to 15).
REDIS_URL=redis://localhost:6379/0

# The tests' own Redis database, which they empty. It must differ from REDIS_URL.
TEST_REDIS_URL=redis://localhost:6379/15

# How many requests each IP address may make in any 60 seconds.
RATE_LIMIT_PER_MINUTE=60

# Signs agents' login tokens. Anyone who has it can log in as any agent, so keep it secret.
# Required. Left empty here so the app won't start with a key everyone can read on GitHub.
# Make one with: openssl rand -hex 32
JWT_SECRET_KEY=

# How long a login token works before the agent has to log in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# The auth token from the Twilio console (Account > API keys & tokens). The WhatsApp webhook
# uses it to check that each request really came from Twilio, and turns every request away
# until it's set.
TWILIO_AUTH_TOKEN=

# The n8n webhook that posts urgent tickets to Slack. n8n runs on port 5678.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/urgent-ticket

# Sent in the X-Webhook-Secret header with every alert, and checked by n8n's Header Auth, so
# only the API can trigger the workflow. Put the same value in n8n. No alerts are sent until
# it's set. Make one with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# The private S3 bucket that uploaded help docs go to (see infra/aws/README.md). Uploads are
# turned away until it's set. Not a secret: only AWS credentials can open it, and boto3 reads
# those from ~/.aws (after aws configure) or the EC2 instance's IAM role, never from here.
S3_BUCKET=support-ai-docs-phanindra02

# Sent by the Lambda that pulls the text out of uploaded PDFs, in the X-Webhook-Secret header,
# so only it can mark documents processed. On EC2 it's in Parameter Store, where the Lambda
# reads it too. Locally, nothing calls that webhook. Make one with: openssl rand -hex 32
LAMBDA_WEBHOOK_SECRET=

# The OpenAI API key, from the support-ai project at platform.openai.com, for both the embeddings
# and the bot's answers. Anyone who has it can spend the account's credit. On EC2 it's in
# Parameter Store. Nothing calls OpenAI until it's set.
OPENAI_API_KEY=

# The model service that predicts each new ticket's priority (ml/service.py). docker compose
# points its containers at the model container itself. For the API run with uvicorn on the
# Mac, use http://localhost:8001. Empty means new tickets stay at medium.
MODEL_SERVICE_URL=

# The AWS region the bucket and the rest of the project's AWS resources are in.
AWS_REGION=us-east-2

# Load any setting that's missing here from AWS Parameter Store, under this path. Empty on the
# Mac. On EC2, infra/aws/compose.ec2.yml sets it to /support-ai, where the secrets are.
PARAMETER_STORE_PATH=

# Only docker compose reads the settings below. The app doesn't.

# The API image compose runs. Leave it empty on the Mac, where compose builds support-ai-api
# itself. On EC2 it's CI's image in ECR: ACCOUNT_ID.dkr.ecr.us-east-2.amazonaws.com/support-ai-api:latest
API_IMAGE=

# The model service's image, the same way: empty on the Mac, and on EC2
# ACCOUNT_ID.dkr.ecr.us-east-2.amazonaws.com/support-ai-model:latest
MODEL_IMAGE=

# The password for Postgres in docker compose, which is separate from Postgres on the Mac.
# Required by docker compose. Letters and digits only, because it goes into a database URL.
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Only on the EC2 server, where the database is RDS instead of a container. It makes every
# docker compose command there read infra/aws/compose.ec2.yml too. Leave it out on the Mac.
# COMPOSE_FILE=docker-compose.yml:infra/aws/compose.ec2.yml
